# Copy thành .env (KHÔNG commit .env). Mọi thành phần (office-mcp, pixel-office, scripts) đều đọc file này.

# ── Paperclip ─────────────────────────────────────────────
PAPERCLIP_URL=http://localhost:3100
# Địa chỉ bạn mở trên trình duyệt = cổng chung của văn phòng (VPS: https://ai.domain-cua-ban.com)
PAPERCLIP_PUBLIC_URL=http://localhost:3200
PAPERCLIP_COMPANY_NAME=AI Office
# Chỉ cần khi Paperclip chạy chế độ có đăng nhập (VPS):  npx paperclipai token board create --name pixel-office --never-expires
PAPERCLIP_API_KEY=

# ── 9Router (model ngoài: GPT-6, Gemini API...) ───────────
# Endpoint OpenAI-compatible của 9Router (xem trong dashboard 9Router).
# Dùng 127.0.0.1 thay vì localhost: trong WSL, localhost ra IPv6 (::1) còn 9Router chỉ nghe IPv4 → timeout.
NINEROUTER_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
# Tên model đúng như 9Router liệt kê (chạy: npm run doctor để xem danh sách)
NINEROUTER_DEFAULT_MODEL=gpt-6
# Kiểu API khi gọi model:
#   auto      = thử /responses (Responses API) trước, lỗi thì tự quay về /chat/completions (mặc định)
#   responses = chỉ dùng /responses
#   chat      = chỉ dùng /chat/completions
NINEROUTER_API_STYLE=auto

# ── Pixel Office = cổng chung ─────────────────────────────
# http://localhost:3200/        → Paperclip (trang chính)
# http://localhost:3200/office/ → văn phòng pixel
PIXEL_OFFICE_PORT=3200
PIXEL_OFFICE_HOST=127.0.0.1
PIXEL_OFFICE_URL=http://localhost:3200
# Token cho agent/n8n gửi trạng thái & job (bắt buộc khi chạy trên VPS). Tạo: openssl rand -hex 24
PIXEL_OFFICE_TOKEN=
# Mật khẩu riêng cho /office (tuỳ chọn; nên đặt khi chạy trên VPS). Paperclip có màn hình đăng nhập riêng.
PIXEL_OFFICE_USER=
PIXEL_OFFICE_PASS=
# 0 = không chèn nút "🏢 Văn phòng" vào giao diện Paperclip
PIXEL_OFFICE_INJECT_LINK=1
