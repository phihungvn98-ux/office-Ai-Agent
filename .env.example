# Copy thành .env (KHÔNG commit .env). Mọi thành phần (office-mcp, pixel-office, scripts) đều đọc file này.

# ── Paperclip ─────────────────────────────────────────────
PAPERCLIP_URL=http://localhost:3100
# URL bạn mở trên trình duyệt (VPS: https://paperclip.domain-cua-ban.com)
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_COMPANY_NAME=AI Office
# Chỉ cần khi Paperclip chạy chế độ có đăng nhập (VPS):  npx paperclipai token board create --name pixel-office --never-expires
PAPERCLIP_API_KEY=

# ── 9Router (model ngoài: GPT-6, Gemini API...) ───────────
# Endpoint OpenAI-compatible của 9Router (xem trong dashboard 9Router)
NINEROUTER_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
# Tên model đúng như 9Router liệt kê (chạy: npm run doctor để xem danh sách)
NINEROUTER_DEFAULT_MODEL=gpt-6

# ── Pixel Office ──────────────────────────────────────────
PIXEL_OFFICE_PORT=3200
PIXEL_OFFICE_HOST=127.0.0.1
PIXEL_OFFICE_URL=http://localhost:3200
# Token cho agent/n8n gửi trạng thái & job (bắt buộc khi chạy trên VPS). Tạo: openssl rand -hex 24
PIXEL_OFFICE_TOKEN=
# Đăng nhập dashboard (tuỳ chọn; trên VPS nên dùng basic auth của Caddy)
PIXEL_OFFICE_USER=
PIXEL_OFFICE_PASS=
