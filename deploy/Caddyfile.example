# Copy thành /etc/caddy/Caddyfile, thay domain và email. Caddy tự lấy HTTPS (Let's Encrypt).
# Chỉ cần 1 domain: cổng chung của AI Office (Pixel Office, cổng 3200) tự chia:
#   https://ai.example.com/         → Paperclip (có màn hình đăng nhập riêng)
#   https://ai.example.com/office/  → văn phòng pixel (bảo vệ bằng PIXEL_OFFICE_USER/PASS trong .env)
{
	email you@example.com
}

ai.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3200 {
		flush_interval -1
	}
}
