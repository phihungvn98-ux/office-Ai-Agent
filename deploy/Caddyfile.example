# Copy thành /etc/caddy/Caddyfile, thay domain và email. Caddy tự lấy HTTPS (Let's Encrypt).
# Tạo mật khẩu băm cho Pixel Office:  caddy hash-password
{
	email you@example.com
}

# Paperclip — có màn hình đăng nhập riêng (chế độ authenticated)
paperclip.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3100
}

# Pixel Office — bảo vệ bằng basic auth; riêng 2 endpoint cho agent/n8n dùng Bearer token
office.example.com {
	encode gzip
	@machine path /api/agent-status /api/jobs/inbox
	handle @machine {
		reverse_proxy 127.0.0.1:3200
	}
	handle {
		basic_auth {
			admin $2a$14$THAY_BANG_KET_QUA_caddy_hash-password
		}
		reverse_proxy 127.0.0.1:3200 {
			flush_interval -1
		}
	}
}
