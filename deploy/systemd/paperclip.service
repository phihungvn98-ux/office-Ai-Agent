# /etc/systemd/system/paperclip.service — thay USER và đường dẫn repo
[Unit]
Description=Paperclip (AI Office control plane)
After=network-online.target
Wants=network-online.target

[Service]
User=USER
WorkingDirectory=/home/USER/ai-office
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx paperclipai run
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed

[Install]
WantedBy=multi-user.target
